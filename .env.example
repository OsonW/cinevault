# ── Required ──────────────────────────────────────────────────────────────────
# Directory where users.db and per-user movie_tracker_{id}.db files live.
# On PythonAnywhere free tier this is typically /home/<yourusername>/data
DB_DIR=/home/yourusername/data

# Random secret for Flask session signing — never commit the real value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# ── Optional ──────────────────────────────────────────────────────────────────
# Gemini model name. Defaults to gemini-3.1-flash-lite if unset.
GEMINI_MODEL=gemini-3.1-flash-lite
